{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rofiant",
  "version": "0.3.1",
  "identifier": "com.rofiant.rofiant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Rofiant",
        "width": 1280,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; media-src 'self' blob:; connect-src 'self' https://nxwzaztltnqdslnvehva.supabase.co https://api.groq.com http://localhost:11434 https:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "shortDescription": "Rofiant: an AI chat desktop app",
    "longDescription": "Rofiant is a desktop AI chat app that can read and edit files with reviewable diffs, connect to local or hosted language models, and extend itself with external tools over the Model Context Protocol (MCP).",
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rofiantai/RofiantDesktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2QzJBNTQ2RDlGQ0Y4MzYKUldRMitQelpScVhDcHY1MkxPMlhDTWJhTEF3UCtlYnovU2Nqb3RRSUQwTW92UTRnQmw3YVlxd3cK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["rofiant"]
      }
    }
  }
}
